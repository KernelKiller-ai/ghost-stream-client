<!--
  ============================================================
  GHOST-STREAM // android/app/src/main/AndroidManifest.xml
  (merge this <manifest> content into the file generated by
   `npm run cap:android`; do not replace the Capacitor boilerplate
   <application> block — only add the permissions/features below)
  ============================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- ============================================================
       BLUETOOTH — Android 12+ (API 31+) runtime-scoped model
       NeverForLocation: asserts BLE scans are not used to derive
       location, so the user is NOT asked for FINE_LOCATION for
       BLE-only scanning. Keep NEVERFORLOCATION only if BLE scans
       are never correlated with location.
       ============================================================ -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
                   android:usesPermissionFlags="neverForLocation" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

  <!-- Bluetooth on Android 11 (API 30) and below — legacy constants
       required when minSdk < 31 (Capacitor default minSdk is 22). -->
  <uses-permission android:name="android.permission.BLUETOOTH"
                   android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
                   android:maxSdkVersion="30" />

  <!-- Required when BLUETOOTH_SCAN is NOT flagged neverForLocation,
       or when BLE MAC-based ranging is combined with geolocation.
       Chrome's Web Bluetooth on Android also requires it. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

  <!-- ============================================================
       WIFI / NEARBY DEVICES — hotspot discovery + local signaling
       ============================================================ -->
  <!-- Android 13+ (API 33) replacement for location-scoped WiFi scans.
       Requires neverForLocation when used without FINE_LOCATION. -->
  <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
                   android:usesPermissionFlags="neverForLocation" />

  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

  <!-- mDNS / SSDP on the hotspot subnet (LAN peer discovery) -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

  <!-- ============================================================
       CAMERA + MICROPHONE — WebRTC video/audio and QR handshake
       ============================================================ -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

  <!-- ============================================================
       NETWORK — cloud relay mode + cleartext LAN signaling
       ============================================================ -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Cleartext ws:// on hotspot IPs (NOT internet-facing) -->
  <application
    android:usesCleartextTraffic="true"
    android:networkSecurityConfig="@xml/network_security_config" />

  <!-- ============================================================
       HARDWARE FEATURE DECLARATIONS (Google Play filtering)
       required=false keeps the app installable on desktops/TVs
       ============================================================ -->
  <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
  <uses-feature android:name="android.hardware.wifi" android:required="false" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />

</manifest>
